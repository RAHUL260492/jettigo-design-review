# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=8787
# Leave DATABASE_URL empty to use the embedded PGlite database in ./.pglite
DATABASE_URL=
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=
# 32+ random characters used to encrypt passport numbers: openssl rand -hex 32
PII_KEY=
CORS_ORIGINS=http://localhost:8765,https://rahul260492.github.io
# Demo only: return the one-time code in the API response (no email provider yet)
DEMO_OTP=true
# Load demo fleet, operators and accounts on startup when the database is empty
SEED_DEMO=true
